#!/usr/bin/env bash
# ==============================================================================
# Canon PIXMA G3010 Series Linux Assistant & Maintenance Suite
# Author: 9M2PJU
# Repository: https://github.com/9M2PJU/9M2PJU-Canon-PIXMA-G3010-Linux-Tool
# ==============================================================================

PRINTER="${CANON_PRINTER_NAME:-Canon_G3010}"
PRINTER_IP="${CANON_PRINTER_IP:-169.254.108.236}"
UTL_DIR="/usr/share/cmdtocanonij2"

# Fallback to local data dir if system utl dir not found
if [ ! -d "$UTL_DIR" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    if [ -d "$SCRIPT_DIR/data/cmdtocanonij2" ]; then
        UTL_DIR="$SCRIPT_DIR/data/cmdtocanonij2"
    fi
fi

wait_for_idle() {
    local max_wait="${1:-30}"
    local count=0
    echo -n "   Waiting for printer to process and return to idle"
    while [ $count -lt "$max_wait" ]; do
        local status
        status=$(lpstat -p "$PRINTER" 2>&1)
        if echo "$status" | grep -qi "is idle"; then
            echo " [OK]"
            return 0
        fi
        echo -n "."
        sleep 2
        count=$((count + 2))
    done
    echo " [Done]"
}

countdown() {
    local seconds=$1
    local msg="$2"
    while [ "$seconds" -gt 0 ]; do
        printf "\r   %s (%02ds remaining)..." "$msg" "$seconds"
        sleep 1
        seconds=$((seconds - 1))
    done
    printf "\r   %s [Finished]            \n" "$msg"
}

run_continuous_routine() {
    clear
    echo "=================================================================="
    echo "   Canon PIXMA G3010 - All-In-One Continuous Maintenance Routine"
    echo "=================================================================="
    echo "This automated routine will run maintenance steps sequentially:"
    echo "  1. Initial Nozzle Check (Baseline test)"
    echo "  2. Print Head Cleaning (Nozzle purge cycle)"
    echo "  3. Verification Nozzle Check (Post-cleaning comparison)"
    echo "  4. Print Head Auto-Alignment Sheet"
    echo "  5. Guided Mechanical Clean (Rollers & Bottom Plate)"
    echo "=================================================================="
    echo ""
    echo "⚠️  Ensure plain A4 paper is loaded in the rear tray before starting."
    read -rp "Start continuous routine now? [Y/n]: " start_choice
    if [[ "$start_choice" =~ ^[nN] ]]; then
        return
    fi

    # Step 0: Check connectivity
    echo ""
    echo "==> [0/5] Checking printer connection ($PRINTER_IP)..."
    if ! ping -c 1 -W 2 "$PRINTER_IP" >/dev/null 2>&1; then
        echo "❌ Error: Cannot reach printer at $PRINTER_IP."
        echo "   Please make sure the printer is powered on and connected to Wi-Fi."
        read -rp "Press Enter to return..."
        return
    fi
    echo "    Printer is online and reachable."

    # Step 1: Initial Nozzle Check
    echo ""
    echo "==> [1/5] Step 1: Printing Initial Baseline Nozzle Check Pattern..."
    lp -d "$PRINTER" "$UTL_DIR/nozzlecheck.utl"
    sleep 3
    wait_for_idle 40
    echo "    Initial Nozzle Check pattern printed."
    echo "    Inspect the printout for any broken lines or missing color grids."
    echo ""
    read -rp "Press Enter to proceed to Print Head Cleaning (or Ctrl+C to abort)..."

    # Step 2: Head Cleaning
    echo ""
    echo "==> [2/5] Step 2: Executing Print Head Cleaning Cycle..."
    lp -d "$PRINTER" "$UTL_DIR/cleaning.utl"
    sleep 3
    countdown 60 "Cleaning print heads & purging nozzles"
    wait_for_idle 30
    echo "    Print head cleaning cycle complete."
    echo ""
    read -rp "Press Enter to proceed to Verification Nozzle Check..."

    # Step 3: Verification Nozzle Check
    echo ""
    echo "==> [3/5] Step 3: Printing Post-Cleaning Verification Nozzle Check..."
    lp -d "$PRINTER" "$UTL_DIR/nozzlecheck.utl"
    sleep 3
    wait_for_idle 40
    echo "    Verification pattern printed."
    echo "    Compare this sheet with the first one to confirm nozzle improvement."
    echo ""

    # Step 4: Head Alignment
    read -rp "Proceed to Step 4: Print Head Auto-Alignment? [Y/n]: " align_choice
    if [[ ! "$align_choice" =~ ^[nN] ]]; then
        echo ""
        echo "==> [4/5] Step 4: Printing Print Head Auto-Alignment Sheet..."
        lp -d "$PRINTER" "$UTL_DIR/autoalign.utl"
        sleep 3
        wait_for_idle 45
        echo "    Alignment sheet printed."
        echo "    To complete alignment calibration:"
        echo "      1. Place the alignment sheet face-down on the scanner glass."
        echo "      2. Press [Setup / 🔧] on the printer until '5' appears on the LCD."
        echo "      3. Press the [Color] or [Black] button."
        echo ""
        read -rp "Press Enter when done with alignment calibration..."
    else
        echo "    Skipping Print Head Alignment."
    fi

    # Step 5: Mechanical Cleaning Guide
    echo ""
    read -rp "Proceed to Step 5: Guided Roller & Bottom Plate Cleaning? [y/N]: " mech_choice
    if [[ "$mech_choice" =~ ^[yY] ]]; then
        clear
        echo "=================================================================="
        echo "==> [5/5] Step 5: Paper Feed Roller & Bottom Plate Cleaning"
        echo "=================================================================="
        echo " Part A: Paper Feed Roller Cleaning:"
        echo "   1. Remove all paper from the rear tray."
        echo "   2. Press [Setup / 🔧] until '6' appears on LCD."
        echo "   3. Press [Black] or [Color] (rollers rotate 3 times without paper)."
        echo "   4. Load 3 sheets of plain A4 paper."
        echo "   5. Press [Black] or [Color] again to feed through and wipe rollers."
        echo ""
        echo " Part B: Bottom Plate Cleaning (Prevents ink smudges on back of paper):"
        echo "   1. Take 1 sheet of A4 paper, fold in half widthwise, then unfold."
        echo "   2. Load in rear tray with the open/creased side facing you."
        echo "   3. Press [Setup / 🔧] until '7' appears on LCD."
        echo "   4. Press [Black] or [Color] to clean bottom plate ribs."
        echo "=================================================================="
        echo ""
        read -rp "Press Enter to finish routine..."
    fi

    echo ""
    echo "=================================================================="
    echo " 🎉 All-In-One Maintenance Routine Complete!"
    echo "=================================================================="
    read -rp "Press Enter to return to main menu..."
}

show_menu() {
    clear
    echo "=================================================================="
    echo "    Canon PIXMA G3010 - Assistant & Maintenance Utility"
    echo "=================================================================="
    echo " ⭐ 0) ALL-IN-ONE CONTINUOUS ROUTINE (Runs 1 to 5 sequentially)"
    echo "------------------------------------------------------------------"
    echo " [Print Head & Ink Maintenance]"
    echo "  1) Nozzle Check Pattern           (Checks for clogged nozzles)"
    echo "  2) Cleaning                       (Standard print head cleaning)"
    echo "  3) Deep Cleaning                  (Cleans stubborn clogs)"
    echo "  4) Ink Flush                      (Purges tubes & fills heads)"
    echo "  5) Print Head Alignment           (Corrects misalignment & lines)"
    echo "  6) Remaining Ink Levels & Reset   (Live IPP check & reset guide)"
    echo ""
    echo " [Paper & Mechanical Cleaning]"
    echo "  7) Roller Cleaning                (Cleans paper feed rollers)"
    echo "  8) Bottom Plate Cleaning          (Cleans interior paper smudges)"
    echo ""
    echo " [Device Management & Settings]"
    echo "  9) Printer Web Remote UI          (Quiet mode, Auto-power, Ink stats)"
    echo " 10) CUPS Printer Status            (http://localhost:631)"
    echo " 11) Complete Hardware Codes Reference"
    echo "  q) Quit"
    echo "=================================================================="
    read -rp "Select an option [0-11, q]: " choice
}

while true; do
    show_menu
    case "$choice" in
        0)
            run_continuous_routine
            ;;
        1)
            echo ""
            echo ">> Sending Nozzle Check Pattern to $PRINTER..."
            lp -d "$PRINTER" "$UTL_DIR/nozzlecheck.utl"
            echo ">> Pattern sent. Verify lines and grid patterns on the printout."
            read -rp "Press Enter to continue..."
            ;;
        2)
            echo ""
            echo ">> Initiating Print Head Cleaning on $PRINTER..."
            lp -d "$PRINTER" "$UTL_DIR/cleaning.utl"
            echo ">> Cleaning started. Please wait ~1-2 minutes until power light is solid."
            read -rp "Press Enter to continue..."
            ;;
        3)
            clear
            echo "=================================================================="
            echo "                DEEP PRINT HEAD CLEANING"
            echo "=================================================================="
            echo "Deep cleaning consumes more ink than standard cleaning."
            echo "To perform Deep Cleaning directly on the Canon G3010:"
            echo ""
            echo "  1. Make sure the printer is turned ON and loaded with paper."
            echo "  2. Press the [Setup / 🔧] button repeatedly until '3' is displayed on the LCD."
            echo "  3. Press the [Black] or [Color] start button."
            echo "  4. Wait ~2-3 minutes until the power lamp stops flashing."
            echo "=================================================================="
            read -rp "Press Enter to return to menu..."
            ;;
        4)
            clear
            echo "=================================================================="
            echo "                  INK FLUSH (SYSTEM CLEANING)"
            echo "=================================================================="
            echo "Ink Flush forces ink through the delivery tubes into the print head."
            echo "⚠️  CAUTION: Consumes a large amount of ink! Check tank levels first."
            echo ""
            echo "  1. Verify all ink tanks are at least 50% full."
            echo "  2. Press the [Setup / 🔧] button repeatedly until '10' is displayed on the LCD."
            echo "  3. Press the [Black] or [Color] start button."
            echo "  4. The ink flush takes approximately 10 minutes to complete."
            echo "=================================================================="
            read -rp "Press Enter to return to menu..."
            ;;
        5)
            echo ""
            echo ">> Sending Print Head Auto-Alignment to $PRINTER..."
            lp -d "$PRINTER" "$UTL_DIR/autoalign.utl"
            echo ""
            echo ">> Alignment sheet printing. For manual scanning alignment:"
            echo "   1. Place printed alignment sheet face down on the scanner glass."
            echo "   2. Press [Setup / 🔧] until '5' appears on the LCD, then press [Black] or [Color]."
            read -rp "Press Enter to continue..."
            ;;
        6)
            clear
            echo "=================================================================="
            echo "                  REMAINING INK LEVELS & STATUS"
            echo "=================================================================="
            echo ""
            echo " [1] Digital Estimated Ink Levels (IPP Query):"
            python3 -c "
import subprocess
try:
    out = subprocess.check_output(['ipptool', '-tv', 'ipp://$PRINTER_IP:631/ipp/print', 'get-printer-attributes.test'], text=True, timeout=5)
    names, levels = [], []
    for line in out.splitlines():
        if 'marker-names' in line and '=' in line:
            names = [x.strip() for x in line.split('=')[1].split(',')]
        if 'marker-levels' in line and '=' in line:
            levels = [int(x.strip()) for x in line.split('=')[1].split(',')]
    color_map = {'BK': 'Black (BK)  ', 'C': 'Cyan (C)    ', 'M': 'Magenta (M) ', 'Y': 'Yellow (Y)  '}
    for n, l in zip(names, levels):
        label = color_map.get(n, n)
        bar = '█' * (l // 5) + '░' * ((100 - l) // 5)
        print(f'     {label}: [{bar}] {l}%')
except Exception as e:
    print('     (Could not query digital marker levels: ' + str(e) + ')')
"
            echo ""
            echo " [2] Physical Visual Check (Primary & Most Accurate):"
            echo "   • Check the front transparent ink tank windows on the printer:"
            echo "       Left side  : Black ink tank (BK)"
            echo "       Right side : Color ink tanks (C, M, Y)"
            echo "   • Upper Line = Full capacity."
            echo "   • Lower Dot (●) = Minimum safe level. (Refill before it drops below!)"
            echo ""
            echo " [3] Reset Remaining Ink Level Count (After refilling to upper line):"
            echo "   • Quick Reset : Press & hold the [Stop] button (red triangle) for 5s."
            echo "   • Setup Menu  : Press [Setup / 🔧] until '8' appears & press [Black]/[Color]."
            echo "=================================================================="
            read -rp "Press Enter to return to menu..."
            ;;
        7)
            clear
            echo "=================================================================="
            echo "                       ROLLER CLEANING"
            echo "=================================================================="
            echo "Cleans paper feed rollers if paper is not feeding smoothly or slipping:"
            echo ""
            echo "  1. Remove all paper from the rear tray."
            echo "  2. Press [Setup / 🔧] until '6' appears on the LCD."
            echo "  3. Press [Black] or [Color] button (rollers will spin 3 times)."
            echo "  4. Load 3 sheets of A4 plain paper into the rear tray."
            echo "  5. Press [Black] or [Color] again to feed the paper through and clean."
            echo "=================================================================="
            read -rp "Press Enter to return to menu..."
            ;;
        8)
            clear
            echo "=================================================================="
            echo "                    BOTTOM PLATE CLEANING"
            echo "=================================================================="
            echo "Cleans the printer interior to prevent smudges on the back of paper:"
            echo ""
            echo "  1. Take one sheet of A4 plain paper, fold it in half widthwise, then unfold."
            echo "  2. Load it in the rear tray with the open side facing you."
            echo "  3. Press [Setup / 🔧] until '7' appears on the LCD."
            echo "  4. Press [Black] or [Color] button (paper will feed and clean interior)."
            echo "=================================================================="
            read -rp "Press Enter to return to menu..."
            ;;
        9)
            echo ""
            echo ">> Opening printer web interface: http://$PRINTER_IP"
            xdg-open "http://$PRINTER_IP" 2>/dev/null || google-chrome-stable "http://$PRINTER_IP" &
            read -rp "Press Enter to continue..."
            ;;
        10)
            echo ""
            echo ">> Opening CUPS status interface: http://localhost:631/printers/$PRINTER"
            xdg-open "http://localhost:631/printers/$PRINTER" 2>/dev/null || google-chrome-stable "http://localhost:631/printers/$PRINTER" &
            read -rp "Press Enter to continue..."
            ;;
        11)
            clear
            echo "=================================================================="
            echo "       CANON PIXMA G3010 - ALL HARDWARE CODES REFERENCE"
            echo "=================================================================="
            echo "  Press [Setup / 🔧] button until number is on LCD, then [Black]/[Color]:"
            echo ""
            echo "  Code 1   : Nozzle Check Pattern"
            echo "  Code 2   : Standard Print Head Cleaning"
            echo "  Code 3   : Deep Print Head Cleaning"
            echo "  Code 4   : Print Head Alignment Pattern Sheet"
            echo "  Code 5   : Scan Alignment Sheet (Alignment calibration)"
            echo "  Code 6   : Paper Feed Roller Cleaning"
            echo "  Code 7   : Bottom Plate Interior Cleaning"
            echo "  Code 8   : Remaining Ink Counter Reset"
            echo "  Code 10  : Ink Flush (Full ink purge/recharge)"
            echo "  Code 11  : Print Wireless LAN Details / Network Configuration"
            echo "=================================================================="
            read -rp "Press Enter to return to menu..."
            ;;
        q|Q)
            echo "Exiting."
            exit 0
            ;;
        *)
            echo "Invalid selection."
            sleep 1
            ;;
    esac
done
