import sys
import os
import subprocess
import threading
import time
import shutil

def detect_canon_printer():
    if "CANON_PRINTER_NAME" in os.environ:
        return os.environ["CANON_PRINTER_NAME"]
    try:
        res = subprocess.run(["lpstat", "-d"], capture_output=True, text=True, timeout=2)
        for line in res.stdout.splitlines():
            if "system default destination:" in line:
                name = line.split(":", 1)[1].strip()
                if name:
                    return name
    except Exception:
        pass
    try:
        res = subprocess.run(["lpstat", "-p"], capture_output=True, text=True, timeout=2)
        for line in res.stdout.splitlines():
            if line.startswith("printer "):
                name = line.split()[1]
                if "canon" in name.lower() or "g30" in name.lower() or "g20" in name.lower() or "g10" in name.lower():
                    return name
    except Exception:
        pass
    return "Canon_G3010"

PRINTER = detect_canon_printer()
PRINTER_IP = os.environ.get("CANON_PRINTER_IP", "169.254.108.236")
PRINTER_WEB_URL = f"http://{PRINTER_IP}"
CUPS_WEB_URL = f"http://localhost:631/printers/{PRINTER}"

def get_utl_path(filename):
    for candidate in [
        f"/usr/share/cmdtocanonij2/{filename}",
        f"/usr/share/cmdtocanonij3/{filename}",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "data", "cmdtocanonij2", filename),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "data", "cmdtocanonij2", filename)
    ]:
        if os.path.exists(candidate):
            return candidate
    return filename

def query_ink_levels():
    """Queries IPP marker levels and returns dict with percentages."""
    try:
        cmd = ["ipptool", "-tv", f"ipp://{PRINTER_IP}:631/ipp/print", "get-printer-attributes.test"]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=4)
        names, levels = [], []
        for line in res.stdout.splitlines():
            if "marker-names" in line and "=" in line:
                names = [x.strip() for x in line.split("=")[1].split(",")]
            if "marker-levels" in line and "=" in line:
                levels = [int(x.strip()) for x in line.split("=")[1].split(",")]
        if names and levels:
            return dict(zip(names, levels))
    except Exception:
        pass
    return {"BK": 100, "C": 100, "M": 100, "Y": 100}

def is_printer_idle():
    try:
        res = subprocess.run(["lpstat", "-p", PRINTER], capture_output=True, text=True, timeout=3)
        return "is idle" in res.stdout
    except Exception:
        return True

def send_lp_command(utl_file):
    path = get_utl_path(utl_file)
    subprocess.run(["lp", "-d", PRINTER, path], check=False)


